{
  "name": "healthlens-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "Backend",
      "Frontend"
    ],
    "nohoist": [
      "**/expo",
      "**/expo/**",
      "**/react-native",
      "**/react-native/**"
    ]
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace=Backend",
    "dev:frontend": "npm run start --workspace=Frontend",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "expo": "expo start --project-root Frontend"
  }
}